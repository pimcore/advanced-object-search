{
  "name": "pimcore/advanced-object-search",
  "license": "proprietary",
  "type": "pimcore-bundle",
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "handcraftedinthealps/elasticsearch-dsl": "^8.0",
    "doctrine/dbal": "^3.2 || ^4.0",
    "pimcore/opensearch-client": "^2.0",
    "pimcore/elasticsearch-client": "^2.0",
    "pimcore/pimcore": "^12.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12.15",
    "ergebnis/phpstan-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "AdvancedObjectSearchBundle\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-7.x": "7.1.x-dev"
    },
    "pimcore": {
      "bundles": [
        "AdvancedObjectSearchBundle\\AdvancedObjectSearchBundle"
      ]
    }
  }
}
